#!/bin/sh

# Exit immediately if a command exits with a non-zero status.
set -e

# Uncomment for debugging:
# set -x

if ! command -v awk >/dev/null 2>&1; then
  echo "awk is required but not installed." >&2
  exit 1
fi

awk '
BEGIN {
    FS = ";"
    map["KIWI"] = "Kiwi"
    map["REMA 1000"] = "Rema 1000"
    map["MENY"] = "Meny"
}
{
    if (NR == 1) {
        print "Date" FS "Payee" FS "Memo" FS "Amount" FS "Cleared"
        next
    }
    # Original csv header
    # Dato;Inn på konto;Ut fra konto;Til konto;Til kontonummer;Fra konto;Fra kontonummer;Type;Tekst;KID;Hovedkategori;Underkategori;Valuta
    # Dato;Beløp;Originalt Beløp;Original Valuta;Til konto;Til kontonummer;Fra konto;Fra kontonummer;Type;Tekst;KID;Hovedkategori;Underkategori
    if ($6 != "" && $6 !~ /^[0-9]{4}\.[0-9]{2}\.[0-9]{5}$/) {
        payee = $6
    }
    if ($5 == "Regninger") {
        payee = "Transfer : Bulder – Regninger"
    }
    payee = (payee in map) ? map[payee] : payee

    payee = (payee == "") ? $10 : payee
    sub(/^Fra: /, "", payee)
    sub(/ Betalt:.*/, "", payee)
    sub(/^Til: /, "", payee)

    amount = $2

    print $1 FS payee FS $10 FS amount FS "Cleared"
    payee = ""
}
' "$@"
